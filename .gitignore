# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
Errors/
Critiques/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local Claude Code settings
.claude/settings.local.json

# agent skills (installed locally, not part of the app)
.agents/
.claude/skills/
skills-lock.json

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
